###############################################################################
# Pugling – CREATOR-Flow (api/v1/creator/*)
#
# Rolle: Creator (Inhalte anlegen). Login als Vater 1 – ein Vater hält die
# Creator- UND Supervisor-Rolle, und besitzt Kind 1 (nötig für den Tag-Schritt).
# Ein reiner Lehrer (fatherId 2 / PIN 9999) kann alle Katalog-Schritte ebenso,
# nur die child-skopierten Tags nicht (kein eigenes Kind).
#
# Von oben nach unten senden: jeder Request zieht Token/IDs aus der vorherigen
# Antwort. Variablen sind DATEI-LOKAL – diese Datei ist ein durchgehender Flow.
#
# Umgebung im REST-Client-Statusleisten-Picker wählen (local = :5200, smoke = :5280).
# baseUrl / Zugänge kommen aus .vscode/settings.json (rest-client.environmentVariables).
###############################################################################

### Login als Vater (hält Creator+Supervisor)
# @name login
POST {{baseUrl}}/auth/father
Content-Type: application/json

{
  "fatherId": {{fatherId}},
  "pin": "{{fatherPin}}"
}

### Token aus der Login-Antwort ziehen
@authToken = {{login.response.body.token}}

### Identität prüfen (roles enthält "Creator")
# @name me
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}

### alle Fächer des Creators abrufen (Array-Response!)
# @name listSubjects
GET {{baseUrl}}/creator/subjects
Authorization: Bearer {{authToken}}

### erste Subject-ID greifen – $[0] = Array-Index-Zugriff
@subjectId = {{listSubjects.response.body.$[0].id}}

### Fach anlegen
# @name createSubject
POST {{baseUrl}}/creator/subjects
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "REST-Client Demo-Fach"
}

### Neue Subject-ID merken
@subjectId = {{createSubject.response.body.id}}

### Anlegen verifizieren: das Fach ist per GET abrufbar
# @name getSubject
GET {{baseUrl}}/creator/subjects/{{subjectId}}
Authorization: Bearer {{authToken}}

### Kapitel im Fach anlegen
# @name createChapter
POST {{baseUrl}}/creator/subjects/{{subjectId}}/chapters
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Lektion 1",
  "orderIndex": 0
}

### Neue Chapter-ID merken
@chapterId = {{createChapter.response.body.id}}

### Zwei Vokabeln aus dem Store lesen (Array-Response!)
# @name getVocabulary
GET {{baseUrl}}/creator/vocabulary?sourceLanguage=en&targetLanguage=de&sort=translation&skip=10&take=2
Authorization: Bearer {{authToken}}

### Erste/zweite Store-Vokabel-ID greifen — $[0] / $[1] = Array-Index-Zugriff
@vocab1Id = {{getVocabulary.response.body.$[0].id}}
@vocab2Id = {{getVocabulary.response.body.$[1].id}}

### Vokabelübung im Kapitel anlegen (refs = Store-Verlinkung per vocabularyId)
# @name createExercise
POST {{baseUrl}}/creator/subjects/{{subjectId}}/chapters/{{chapterId}}/vocabulary
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "REST-Client Demo-Vokabeln",
  "orderIndex": 0,
  "rewardPoints": 10,
  "config": {
    "direction": "front-to-back",
    "sourceLang": "en",
    "targetLang": "de",
    "refs": [
      { "vocabularyId": {{vocab1Id}} },
      { "vocabularyId": {{vocab2Id}} }
    ]
  }
}

### Neue Exercise-ID merken
@exerciseId = {{createExercise.response.body.id}}

### Anlegen verifizieren: die materialisierten Items der Übung lesen
# @name getItems
GET {{baseUrl}}/creator/subjects/{{subjectId}}/chapters/{{chapterId}}/vocabulary/{{exerciseId}}/items
Authorization: Bearer {{authToken}}

### Übungskatalog nach Typ filtern
# @name listExercises
GET {{baseUrl}}/creator/exercises?type=Vocabulary&take=5
Authorization: Bearer {{authToken}}

### Übung nebenwirkungsfrei durchspielen (Preview/Testmodus)
# @name preview
GET {{baseUrl}}/creator/exercises/{{exerciseId}}/preview
Authorization: Bearer {{authToken}}

### Tag anlegen (child-skopiert – Vater 1 besitzt Kind {{childId}})
# @name createTag
POST {{baseUrl}}/creator/tags
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "childId": {{childId}},
  "name": "REST-Demo-{{$timestamp}}",
  "color": "#22aa55"
}

### Neue Tag-ID merken
@tagId = {{createTag.response.body.id}}

### Verfügbare Übungstypen (Manifest) lesen
# @name exerciseTypes
GET {{baseUrl}}/creator/exercise-types
Authorization: Bearer {{authToken}}

###############################################################################
# Rechte teilen (RWX): Owner/Write/Execute pro Übung. Read bleibt global.
# Der Anleger ist automatisch Owner; nur ein Owner darf Rechte sehen/vergeben.
###############################################################################

### Vergebene Rechte der Übung ansehen (nur Owner) – zeigt den Auto-Owner-Grant
# @name listGrants
GET {{baseUrl}}/creator/exercises/{{exerciseId}}/grants
Authorization: Bearer {{authToken}}

### Write-Recht an einen anderen Creator vergeben (Co-Authoring); permission: Owner|Write|Execute
# @name addGrant
POST {{baseUrl}}/creator/exercises/{{exerciseId}}/grants
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "creatorId": 2,
  "permission": "Write"
}

### Zuweisen für alle abschalten (executePublic=false) – nur Owner/Write/Execute dürfen dann noch zuweisen
# @name restrictExecute
PUT {{baseUrl}}/creator/subjects/{{subjectId}}/chapters/{{chapterId}}/vocabulary/{{exerciseId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "REST-Client Demo-Vokabeln",
  "orderIndex": 0,
  "rewardPoints": 10,
  "executePublic": false,
  "config": { "direction": "front-to-back", "sourceLang": "en", "targetLang": "de" }
}

### Recht wieder entziehen (permission im Pfad); der letzte Owner ist nicht entfernbar
# @name removeGrant
DELETE {{baseUrl}}/creator/exercises/{{exerciseId}}/grants/2/Write
Authorization: Bearer {{authToken}}
###############################################################################
# Unterrichtsmaterial & Creator-Profile: welcher Stoff ist dran, und wer kennt ihn?
# Die Lehrwerk-Reihe ist geteilt (jeder Creator liest, nur der Owner ändert) und
# verbindet das Lehrbuch des Kindes mit dem darauf optimierten Creator-Profil.
###############################################################################

### Lehrwerk-Reihe anlegen (Name schon vergeben ⇒ 200 mit der bestehenden Reihe)
# @name createSeries
POST {{baseUrl}}/creator/textbook-series
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Access REST-Demo",
  "publisher": "Cornelsen",
  "subjectName": "Englisch",
  "subjectId": {{subjectId}},
  "schoolTypes": "Gymnasium",
  "sourceLanguage": "en",
  "targetLanguage": "de",
  "notes": "Kompetenzorientiertes Lehrwerk, ein Band je Jahrgang."
}

### Neue Series-ID merken
@seriesId = {{createSeries.response.body.id}}

### Unit anlegen – topics/grammar/vocabularyNotes sind der Stoff, den der KI-Creator liest
# @name createUnit
POST {{baseUrl}}/creator/textbook-series/{{seriesId}}/units
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "label": "Unit 3 - Growing up",
  "grade": 8,
  "orderIndex": 3,
  "topics": "Familie, Freundschaft, Erwachsenwerden",
  "grammar": "Present perfect vs. simple past",
  "vocabularyNotes": "to grow up, responsibility, to argue"
}

### Neue Unit-ID merken
@unitId = {{createUnit.response.body.id}}

### Units der Reihe lesen (nach Band und Reihenfolge)
# @name listUnits
GET {{baseUrl}}/creator/textbook-series/{{seriesId}}/units?grade=8
Authorization: Bearer {{authToken}}

### Creator-Profil anlegen (der "Fachlehrer": persona/didactics prägen den System-Prompt)
# @name createProfile
POST {{baseUrl}}/creator/profiles
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Englisch 8 Gymnasium - Access REST-Demo",
  "subjectName": "Englisch",
  "subjectId": {{subjectId}},
  "schoolTypes": "Gymnasium",
  "gradeMin": 7,
  "gradeMax": 8,
  "seriesId": {{seriesId}},
  "sourceLang": "en",
  "targetLang": "de",
  "persona": "Du bist Englischlehrer an einem Gymnasium.",
  "didactics": "Kurze Sätze, maximal zwölf Wörter. Progression wie im Lehrwerk.",
  "defaultTypes": ["Vocabulary", "Cloze"]
}

### Neue Profil-ID merken
@profileId = {{createProfile.response.body.id}}

### Reihe + aktuelle Unit am Lehrbuch des Kindes hinterlegen (Supervisor-Route!)
# @name linkTextbook
POST {{baseUrl}}/supervisor/children/{{childId}}/textbooks
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Access 8",
  "subjectName": "Englisch",
  "subjectId": {{subjectId}},
  "grade": 8,
  "publisher": "Cornelsen",
  "seriesId": {{seriesId}},
  "currentUnitId": {{unitId}}
}

### Den passenden Creator zum Kind finden: Reihe (8) > Fach (4) > Klassenstufe (2) > Schulart (1)
# Braucht ein Konto, das dieses Kind betreut – sonst 403 forbidden.
# @name matchProfiles
GET {{baseUrl}}/creator/profiles/match?childId={{childId}}&subjectId={{subjectId}}
Authorization: Bearer {{authToken}}
