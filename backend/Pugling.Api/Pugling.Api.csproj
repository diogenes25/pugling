<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pugling.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 hier (noch) unterdrückt – anders als in Contracts/Client/Agent.Creator, wo die Regel scharf ist.
      Gemessen: 545 Stellen im Projekt, davon **428 in `Models/` und `Data/`** – EF-Entities und der
      DbContext, die nur wegen EF `public` sind. Für die trägt die Begründung der Doku-Regel („fließt in
      Swagger") nicht, und eine Ratsche mit 428 Ausnahmen ist keine. Die verbleibenden ~117 in
      `Controllers/`, `Auth/`, `Errors/`, `Services/` und `Exercises/` sind echte Lücken – sie nachzuziehen
      und CS1591 dann per `.editorconfig` pfadweise scharf zu stellen, steht als Nacharbeit in
      docs/codequalitaet-gates-plan.md.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Projektweit verfügbar, damit [ApiVersion] an den Controllern kein per-Datei-using braucht. -->
  <ItemGroup>
    <Using Include="Asp.Versioning" />
  </ItemGroup>

  <!--
    Die Ebenen-Sub-Namespaces (Creator/Supervisor/Student/Shared) sind projektweit verfügbar.
    So bleibt die fachliche Ordner-/Namespace-Struktur nach den drei Ebenen (docs/grundprinzip.md)
    ohne flächigen per-Datei-using-Churn zwischen Controllern und ebenenübergreifenden Services.
  -->
  <ItemGroup>
    <Using Include="Pugling.Api.Controllers.Creator" />
    <Using Include="Pugling.Api.Controllers.Supervisor" />
    <Using Include="Pugling.Api.Controllers.Student" />
    <Using Include="Pugling.Api.Services.Creator" />
    <Using Include="Pugling.Api.Services.Supervisor" />
    <Using Include="Pugling.Api.Services.Student" />
    <Using Include="Pugling.Api.Services.Shared" />
    <Using Include="Pugling.Api.Exercises" />
    <Using Include="Pugling.Contracts" />
    <Using Include="Pugling.Contracts.Auth" />
    <Using Include="Pugling.Contracts.Creator" />
    <Using Include="Pugling.Contracts.Shared" />
    <Using Include="Pugling.Contracts.Supervisor" />
    <Using Include="Pugling.Contracts.Student" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pugling.Contracts\Pugling.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="OpenApi\openapi-examples.generated.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('OpenApi\openapi-examples.generated.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
    <!-- Strukturiertes Logging (Konsole + rollierende JSON-Datei) + DB-Health-Check für Diagnose/Betrieb. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Bild-Skalierung für die Medien-Varianten (Upload → Thumb/Card/Full). Bewusst SkiaSharp und NICHT
         ImageSharp: dessen Split-Lizenz bricht seit 4.0 den Build ohne Lizenzschlüssel und wäre
         kommerziell lizenzpflichtig. SkiaSharp ist MIT/BSD; die NativeAssets sind nur für einen
         Linux-Deploy nötig (Windows/macOS bringt SkiaSharp selbst mit). -->
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <!-- Transitive Security-Overrides (CVE-2026-49451 / CVE-2025-6965) – 2.x-Branch; 3.x bricht das AspNetCore.OpenApi-SourceGenerator -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
  </ItemGroup>

</Project>
