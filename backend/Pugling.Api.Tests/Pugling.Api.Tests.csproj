<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      `GenerateDocumentationFile` nicht wegen der Doku, sondern weil Roslyn IDE0005 (unbenutzte usings)
      im Build sonst gar nicht auswertet (dotnet/roslyn#41640) und stattdessen mit
      `EnableGenerateDocumentationFile` abbricht. CS1591 bleibt hier folgerichtig unterdrückt: Testnamen
      sind die Beschreibung, sie fließen in kein Swagger und brauchen kein `/// <summary>`.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);xUnit1051;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Service-Ebenen (Creator/Supervisor/Student/Shared) projektweit, damit Service-Unit-Tests kein per-Datei-using brauchen. -->
    <Using Include="Pugling.Api.Services.Creator" />
    <Using Include="Pugling.Api.Services.Supervisor" />
    <Using Include="Pugling.Api.Services.Student" />
    <Using Include="Pugling.Api.Services.Shared" />
    <Using Include="Pugling.Contracts" />
    <Using Include="Pugling.Contracts.Auth" />
    <Using Include="Pugling.Contracts.Creator" />
    <Using Include="Pugling.Contracts.Shared" />
    <Using Include="Pugling.Contracts.Supervisor" />
    <Using Include="Pugling.Contracts.Student" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pugling.Api\Pugling.Api.csproj" />
    <ProjectReference Include="..\Pugling.Contracts\Pugling.Contracts.csproj" />
    <ProjectReference Include="..\Pugling.Client\Pugling.Client.csproj" />
    <ProjectReference Include="..\Pugling.Agent.Creator\Pugling.Agent.Creator.csproj" />
  </ItemGroup>

</Project>