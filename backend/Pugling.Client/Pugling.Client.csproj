<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pugling.Client</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 bleibt scharf – siehe Pugling.Contracts.csproj. -->
  </PropertyGroup>

  <!-- Die Vertrags-Namespaces projektweit sichtbar (wie in Pugling.Api), damit die dünnen
       Wrapper ohne per-Datei-usings auskommen. -->
  <ItemGroup>
    <Using Include="Pugling.Contracts" />
    <Using Include="Pugling.Contracts.Auth" />
    <Using Include="Pugling.Contracts.Creator" />
    <Using Include="Pugling.Contracts.Supervisor" />
    <Using Include="Pugling.Contracts.Student" />
    <Using Include="Pugling.Contracts.Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pugling.Contracts\Pugling.Contracts.csproj" />
  </ItemGroup>

</Project>
