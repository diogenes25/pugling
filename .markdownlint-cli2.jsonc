{
  // Läufer-Konfiguration für markdownlint-cli2. Die Regeln stehen in .markdownlint.jsonc,
  // hier stehen nur der Geltungsbereich (Glob) und die auszuschließenden Pfade.
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "frontend/**",
    ".claude/**",
    ".agents/**",
    "lehrplan/**",
    // Generierter Schnappschuss der Anmerkungen: der Inhalt ist freier Nutzertext aus dem Widget.
    // Eine Aufzählung oder ein Leerzeichen am Zeilenende macht CI sonst rot, ohne dass es jemand
    // beheben könnte – der Export überschreibt die Datei bei jedem Lauf.
    "docs/anmerkungen/aktuell.md"
  ]
}
