# Gebautes Frontend wird beim Deploy nach wwwroot kopiert – nicht einchecken (Ordner bleibt via .gitkeep)
backend/Pugling.Api/wwwroot/*
!backend/Pugling.Api/wwwroot/.gitkeep
.vs/
.idea/
.env

# Tool-/Editor-Artefakte
.opencode/
.claude/settings.local.json
.opencode

.fake

# Obsidian: lokale Vault-Konfiguration (Plugins/Layout/Workspace) – die .md-Doku bleibt die Quelle der
# Wahrheit, die Tool-Config gehört nicht ins Repo. Siehe docs/obsidian.md.
.obsidian/

# Bruno: die generierte API-Collection ändert sich mit fast jeder Änderung und ist jederzeit
# reproduzierbar via tools/bruno/generate-bruno.mjs – daher nicht einchecken (Generator + README bleiben versioniert).
tools/bruno/Pugling.Api/

# Extern (per `npx skills`) installierte Agent-Skills liegen user-global unter ~/.claude/skills und
# gehoeren nicht hierher – .claude/skills/ traegt ausschliesslich die versionierten projekteigenen Skills.
.agents/
skills-lock.json
# Hochgeladene Medien (Bilder) – Nutzerinhalte, gehören nicht ins Repo
backend/Pugling.Api/media-uploads/

# Fingerprint des letzten grünen Test-Tor-Laufs (.claude/hooks/test-gate.sh) – lokaler Zustand.
.claude/.test-gate-state

# Zuletzt gemessene Groessen des Startkontexts (.claude/scripts/context-budget.sh) – lokaler Zustand.
.claude/.context-budget-state
