<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <!-- Godot 4.7.2's Android export template supports at most net9.0 (measured in B-850). -->
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>PuglingTower</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Pugling.Contracts targets net10.0 and cannot be referenced as a project; its sources are compiled in
      instead, which keeps one source of truth for the DTOs (B-850, decision 9 of B-822).
    -->
    <Compile Include="..\backend\Pugling.Contracts\**\*.cs"
             Exclude="..\backend\Pugling.Contracts\obj\**;..\backend\Pugling.Contracts\bin\**"
             LinkBase="Contracts" />
  </ItemGroup>
</Project>
