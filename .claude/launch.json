{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--no-launch-profile",
        "--project",
        "backend/Pugling.Api",
        "--",
        "--urls=http://localhost:5210",
        "--ConnectionStrings:Default=Data Source=pugling_dev.db"
      ],
      "port": 5210,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173,
      "env": {
        "PUGLING_API_URL": "http://localhost:5210"
      }
    },
    {
